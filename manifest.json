{
  "manifest_version": 3,
  "name": "TabVault — Tab Session Saver",
  "version": "0.4.1",
  "description": "Save tabs by project, restore browser groups and revisit local snapshots. Free JSON backups; optional Pro organization and history.",
  "author": "you",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel",
    "tabGroups"
  ],
  "action": {
    "default_title": "Open TabVault sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current window as a session"
    }
  },
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://tabvault-pro-api.wd933781.workers.dev/*",
    "https://pay-tabvault.tabplugins.top/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://tabvault-pro-api.wd933781.workers.dev/*",
      "https://pay-tabvault.tabplugins.top/*"
    ]
  },
  "homepage_url": "https://tabvault.tabplugins.top/"
}
