{
  "manifest_version": 3,
  "name": "TabVault — Tab Session Saver",
  "version": "0.2.1",
  "description": "Save browser tabs as sessions and restore them later. Optional Pro backups keep up to 20 snapshots across normal windows.",
  "author": "you",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open TabVault sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current window as a session"
    }
  },
  "minimum_chrome_version": "116"
}
